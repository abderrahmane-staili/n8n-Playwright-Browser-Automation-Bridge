{
  "name": "Playwright Bridge - fill a form and take a screenshot",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/browser/navigate",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{ $env.PLAYWRIGHT_BRIDGE_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"url\": \"https://httpbin.org/forms/post\"}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Navigate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/browser/fill",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{ $env.PLAYWRIGHT_BRIDGE_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { sessionId: $('Navigate').first().json.sessionId, selector: 'input[name=custname]', value: 'Hello from n8n' } }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Fill name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/browser/screenshot",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{ $env.PLAYWRIGHT_BRIDGE_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { sessionId: $('Navigate').first().json.sessionId, fullPage: true } }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Screenshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "base64",
        "options": { "fileName": "screenshot.png", "mimeType": "image/png" }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Convert to PNG file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ 'http://localhost:3000/browser/session/' + $('Navigate').first().json.sessionId }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-api-key", "value": "={{ $env.PLAYWRIGHT_BRIDGE_API_KEY }}" }] },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Close session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Navigate", "type": "main", "index": 0 }]] },
    "Navigate": { "main": [[{ "node": "Fill name", "type": "main", "index": 0 }]] },
    "Fill name": { "main": [[{ "node": "Screenshot", "type": "main", "index": 0 }]] },
    "Screenshot": { "main": [[{ "node": "Convert to PNG file", "type": "main", "index": 0 }]] },
    "Convert to PNG file": { "main": [[{ "node": "Close session", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
